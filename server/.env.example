# Copy to .env and fill in. Never commit the filled-in copy.

# --- Chat agent (bottom section) ---------------------------------------------
# Required for "Weather Ai Agent - Australia".
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest, which is verified to support the
# function calling the agent needs. Note that some models (gemini-2.5-flash,
# gemini-2.5-flash-lite) are closed to newer API keys even though they appear in
# the model list — `npm run check` will tell you if yours is one of them.
# GEMINI_MODEL=gemini-flash-latest

# Optional: use Claude instead of Gemini. An Anthropic API key is a separate paid
# product from a Claude.ai subscription; Gemini has a free tier.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Email delivery ----------------------------------------------------------
# "compose" (default) opens a pre-filled Gmail window and you press Send.
# Nothing below is needed in this mode.
MAIL_MODE=compose

# Switch to smtp for fully automatic sending. Requires 2-Step Verification on the
# Google account, then an App Password from myaccount.google.com/apppasswords.
# MAIL_MODE=smtp
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# GMAIL_FROM=you@gmail.com

# --- Server ------------------------------------------------------------------
PORT=8787
# Comma-separated origins allowed to call the API cross-origin. Leave empty for
# same-origin only. The Android app does not need an entry here.
# ALLOWED_ORIGINS=https://geeya97.github.io
RATE_LIMIT_MAX=60
# Sending is limited separately, since this endpoint can put mail in an inbox.
SEND_RATE_LIMIT_MAX=12

# Only needed to run a real test send via GET /api/preflight on a deployed host.
# Any random string. Without it, ?deliverTo= is ignored over HTTP so a stranger
# who finds your URL cannot make the server email your family.
# PREFLIGHT_TOKEN=
