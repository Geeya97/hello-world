# Copy to .env and fill in. Never commit the filled-in copy.

# --- Chat agent (bottom section) ---------------------------------------------
# Required for "Weather Ai Agent - Australia". Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Email delivery ----------------------------------------------------------
# "compose" (default) opens a pre-filled Gmail window and you press Send.
# Nothing below is needed in this mode.
MAIL_MODE=compose

# Switch to smtp for fully automatic sending. Requires 2-Step Verification on the
# Google account, then an App Password from myaccount.google.com/apppasswords.
# MAIL_MODE=smtp
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# GMAIL_FROM=you@gmail.com

# --- Server ------------------------------------------------------------------
PORT=8787
# Comma-separated origins allowed to call the API cross-origin. Leave empty for
# same-origin only. The Android app does not need an entry here.
# ALLOWED_ORIGINS=https://geeya97.github.io
RATE_LIMIT_MAX=60
